# ==============================================================================
# Bake Bliss - Environment Configuration Template
# ==============================================================================
# Copy this file to .env for local development:
#   cp .env.example .env
#
# DO NOT commit your actual .env file with real credentials to GitHub.
# ==============================================================================

# Database Connection Settings
DB_HOST=localhost
DB_PORT=3306
DB_NAME=bakebliss
DB_USER=root
DB_PASS=

# Optional: Full Database Connection URL (used by cloud platforms such as Railway, Render, etc.)
# If provided, this connection string is automatically parsed and used.
# DATABASE_URL=mysql://root:password@localhost:3306/bakebliss

# Application Environment (local, staging, production)
APP_ENV=local
