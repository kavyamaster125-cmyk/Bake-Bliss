# ==============================================================================
# Git Ignore Rules for Bake Bliss
# ==============================================================================

# Environment files & secrets
.env
.env.*
!.env.example

# Razer Cortex media & recordings
RazerCortexGameClip/
[Rr]azer[Cc]ortex[Gg]ame[Cc]lip/

# Operating System files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# IDE & Editor files
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.agents/

# Backups & Archives
*.zip
*.tar.gz
*.rar
*.7z
*.bak
*.old
*~

# Logs & Temporary files
*.log
tmp/
temp/

# Explicitly keep database schema and uploads folder placeholder intact
!database.sql
!uploads/.gitkeep
